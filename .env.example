# Connection details for a real Trek server, used for manual/exploratory API
# testing against the actual backend contract (not read by the Flutter app
# itself — server config there is entered at runtime via ServerSetupScreen
# and persisted through shared_preferences, see docs/networking-auth.md).
#
# Copy to .env and fill in real values. .env is gitignored; never commit it.

TREK_SERVER_URL=https://trek.example.com

# Generated by scripts/get_trek_token.sh — don't fill this in by hand.
TREK_SESSION_TOKEN=

# Optional — only needed if you want scripts/get_trek_token.sh to skip its
# interactive prompts. TREK_PASSWORD sits in plaintext on disk if you set
# it; a leaked session token above is bounded (Trek JWTs expire), a leaked
# password isn't. Prefer the interactive prompt unless you're re-running
# the script often enough that this trade-off is worth it to you.
TREK_EMAIL=
TREK_PASSWORD=
